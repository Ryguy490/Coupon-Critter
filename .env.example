# Port the server listens on
PORT=3000

# Weather data provider keys.
# These have safe defaults baked in (the keys supplied for this project),
# but you can override them here.
WEATHERAPI_KEY=6c167a50ff574618987180912261306
PIRATE_WEATHER_KEY=r7yOLHkOseKaqzJUOVHKSlSt0UlEPNSN

# Anthropic API key. Required ONLY for the AI-generated summaries
# (home weather-pattern overview, daily forecast summary, drought summary).
# The rest of the app works without it.
ANTHROPIC_API_KEY=

# Model used for the AI summaries.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
